{
    "name": "backend",
    "version": "0.0.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "tsc && node build.ts",
        "check": "npm run check:format && npm run check:lint && npm run build",
        "check:format": "npx prettier . --check",
        "check:lint": "eslint .",
        "codegen": "npx orval",
        "dev": "tsx watch --env-file=../.env --include ../config.public.yaml src/index.ts",
        "fix": "npm run fix:lint && npm run fix:format",
        "fix:format": "npx prettier . -w",
        "fix:lint": "eslint . --fix",
        "start": "node --env-file=../.env dist/index.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/markdown": "^8.0.3",
        "@tsconfig/node24": "24.0.5",
        "@tsconfig/strictest": "2.0.8",
        "@types/express": "^5.0.6",
        "@types/node": "26.6.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "jiti": "^2.7.0",
        "orval": "^8.37.0",
        "prettier": "3.9.9",
        "tsx": "^4.23.15",
        "typescript-eslint": "^8.70.1"
    },
    "dependencies": {
        "@turf/turf": "^7.4.0",
        "common": "*",
        "express": "^5.2.1",
        "yaml": "^2.9.1",
        "zod": "4.6.5"
    }
}
